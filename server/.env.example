# Salin file ini menjadi server/.env lalu isi nilainya. Jangan dibagikan: token = kunci bot kamu.

# Token dari @BotFather di Telegram (perintah /newbot)
TELEGRAM_TOKEN=

# ID Telegram kamu. Kosongkan dulu, jalankan server, kirim pesan ke bot, bot akan membalas dengan ID-mu.
TELEGRAM_ALLOWED_ID=

# Opsional, bawaan 3000
# PORT=3000
